{
  "name": "@danielsimonjr/verify",
  "version": "0.6.0",
  "description": "Same-model verification harness for long-horizon workspace agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/verify.git"
  },
  "type": "module",
  "files": [
    "dist",
    "harness",
    "!harness/vendor",
    "!**/__pycache__",
    "!**/*.pyc",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "veriharness": "./dist/harness/cli.js"
  },
  "scripts": {
    "dev": "bun harness/cli.ts",
    "driver": "bun harness/driver.ts",
    "runner": "bun harness/runner.ts",
    "score": "bun harness/score.ts",
    "materialize": "bun harness/materialize/main.ts",
    "grade": "bun harness/grade/main.ts",
    "env:derive": "bun harness/env/derive.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/harness/cli.js",
    "smoke": "node tests/smoke/built-cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test --timeout 30000",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.7.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
